{
  "name": "repo-atlas",
  "version": "0.1.0",
  "description": "Incremental, agent-friendly codebase atlas: per-path descriptions with git-hash staleness tracking and a self-contained HTML viewer.",
  "type": "module",
  "bin": {
    "repo-atlas": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/vendor",
    "qa",
    "docs/readability-audit.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.5.0",
    "@lingui/cli": "^6.5.0",
    "@lingui/conf": "^6.5.0",
    "@lingui/core": "^6.5.0",
    "@lingui/format-po": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-lingui-macro": "^1.0.2",
    "happy-dom": "^20.11.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "postcss": "^8.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:viewer",
    "build:cli": "tsc -p tsconfig.json",
    "build:viewer": "lingui compile && node viewer/build.mjs",
    "prepack": "pnpm build",
    "test": "pnpm build:cli && node --test test/*.test.mjs",
    "dev:viewer": "lingui compile && node viewer/build.mjs --watch",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.viewer.json"
  }
}
